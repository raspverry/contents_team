# AI 프로바이더 설정 ("anthropic" 또는 "openai")
AI_PROVIDER=anthropic

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL=claude-sonnet-4-5-20250929
MAX_TOKENS=4096

# OpenAI Responses API (AI_PROVIDER=openai 일 때 사용)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_TOKENS=4096

# 브랜드 — 주제/도메인을 바꾸면 에이전트 프롬프트에 자동 반영
BRAND_NAME=재테크는 스크루지
BRAND_HANDLE=@재테크는스크루지
BRAND_TOPIC=재테크
BRAND_DESCRIPTION=돈에 관한 모든 이야기를 쉽고 재밌게 전달하는 콘텐츠 브랜드
BRAND_DISCLAIMER=본 콘텐츠는 전문적 조언이 아닙니다. 중요한 결정은 전문가와 상담하세요.

# 서버
API_HOST=127.0.0.1
API_PORT=8000
GUI_PORT=8501

# 레이트 리미팅 (분당 횟수)
RATE_LIMIT_RUN=10
RATE_LIMIT_WORKFLOW=5
